            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomTable = Math.floor(Math.random() * 12) + 1;",
                  "var randomDay = Math.floor(Math.random() * 15) + 10;",
                  "var randomHour = Math.floor(Math.random() * 8) + 11;",
                  "var timeStr = \"2026-11-\" + randomDay + \"T\" + (randomHour < 10 ? \"0\" + randomHour : randomHour) + \":00:00\";",
                  "pm.collectionVariables.set(\"dynamicTable\", randomTable);",
                  "pm.environment.set(\"dynamicTable\", randomTable);",
                  "pm.collectionVariables.set(\"dynamicBookingTime\", timeStr);",
                  "pm.environment.set(\"dynamicBookingTime\", timeStr);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Booking processed with status 201 Created or 409 Conflict\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
                  "    if (pm.response.code === 201 || pm.response.code === 200) {",
                  "        var raw = pm.response.json();",
                  "        var data = raw.data || raw;",
                  "        pm.expect(data.bookingNumber).to.be.a(\"string\");",
                  "        pm.environment.set(\"bookingNumber\", data.bookingNumber);",
                  "        pm.collectionVariables.set(\"bookingNumber\", data.bookingNumber);",
                  "    }",
