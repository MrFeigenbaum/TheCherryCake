                  "pm.test(\"KAZ currency is KZT and VAT is 20%\", function () {",
                  "    var raw = pm.response.json();",
                  "    var data = raw.data || raw;",
                  "    var curr = data.currency || data.currencyCode;",
                  "    pm.expect(curr).to.eql(\"KZT\");",
                  "    var rate = parseFloat(data.vatRate);",
                  "    var ratePercent = rate <= 1.0 ? Math.round(rate * 100) : rate;",
                  "    pm.expect(ratePercent).to.eql(20);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
