    {
      "name": "3. Cart & BigDecimal Financial Engine",
      "item": [
        {
          "name": "Calculate Cart (Standard - UZB)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cart/calculate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "cart",
                "calculate"
              ]
            },
            "description": "Strict financial calculation verifying exact subtotal, VAT, and finalTotal",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"regionCode\": \"UZB\",\n  \"orderType\": \"PICKUP\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2,\n      \"modifierIds\": []\n    },\n    {\n      \"productId\": 2,\n      \"quantity\": 1,\n      \"modifierIds\": []\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Financial reconciliation: Subtotal - Discount + VAT + Delivery = FinalTotal\", function () {",
                  "    var raw = pm.response.json();",
                  "    var data = raw.data || raw;",
                  "    var finalTotal = parseFloat(data.finalTotal != null ? data.finalTotal : data.total);",
                  "    pm.expect(finalTotal).to.be.closeTo(parseFloat(data.total), 0.05);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
