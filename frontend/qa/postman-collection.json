                  "});",
                  "pm.test(\"Finland 25.5% VAT correctly applied in EUR\", function () {",
                  "    var raw = pm.response.json();",
                  "    var data = raw.data || raw;",
                  "    var curr = data.currency || data.currencyCode;",
                  "    pm.expect(curr).to.eql(\"EUR\");",
