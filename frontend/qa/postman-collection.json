              "mode": "raw",
              "raw": "{\n  \"regionCode\": \"FIN\",\n  \"orderType\": \"PICKUP\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 1,\n      \"modifierIds\": []\n    }\n  ]\n}"
            }
