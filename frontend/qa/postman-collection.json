  "item": [
    {
      "name": "1. Authentication & Security (JWT)",
      "item": [
        {
          "name": "Login as Regular Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates customer and extracts JWT token into authToken variable",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token is issued and user role is ROLE_USER\", function () {",
                  "    var raw = pm.response.json();",
                  "    var data = raw.data || raw;",
                  "    pm.expect(data.token).to.be.a(\"string\");",
                  "    pm.expect([\"ROLE_USER\", \"ROLE_CUSTOMER\", \"CUSTOMER\"]).to.include(data.role);",
                  "    var token = data.token;",
                  "    pm.environment.set(\"authToken\", token);",
                  "    pm.collectionVariables.set(\"authToken\", token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login as Administrator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates administrator and extracts JWT token into adminToken variable",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Admin role confirmed\", function () {",
                  "    var raw = pm.response.json();",
                  "    var data = raw.data || raw;",
                  "    pm.expect(data.token).to.be.a(\"string\");",
                  "    pm.expect([\"ROLE_ADMIN\", \"ADMIN\"]).to.include(data.role);",
                  "    var token = data.token;",
                  "    pm.environment.set(\"adminToken\", token);",
                  "    pm.collectionVariables.set(\"adminToken\", token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register New Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Registers a new customer account with unique dynamic email",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{dynamicEmail}}\",\n  \"password\": \"password123\",\n  \"fullName\": \"Alice Wonderland\",\n  \"phone\": \"+998909998877\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var uniqueId = Date.now();",
                  "var dynEmail = \"guest_\" + uniqueId + \"@cherrycake.com\";",
                  "pm.collectionVariables.set(\"dynamicEmail\", dynEmail);",
                  "pm.environment.set(\"dynamicEmail\", dynEmail);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"Registration issues JWT token\", function () {",
                  "    var raw = pm.response.json();",
                  "    var data = raw.data || raw;",
                  "    pm.expect(data.token).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
