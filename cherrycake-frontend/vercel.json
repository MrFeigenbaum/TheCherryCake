{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/swagger-ui",
      "destination": "/swagger.html"
    },
    {
      "source": "/((?!assets|v3|swagger|mockups|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

